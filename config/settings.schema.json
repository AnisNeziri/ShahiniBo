{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShahiniBot paper and monitor settings",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "capture": {
          "type": "string",
          "minLength": 1
        },
        "feed": {
          "type": "object",
          "properties": {
            "rpcEnv": {
              "type": "string",
              "minLength": 1
            },
            "wsEnv": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "staleMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 300000
            },
            "maxQueue": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8192
            },
            "backlogSlots": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "hydrationDeadlineMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 60000
            },
            "launchesOnly": {
              "type": "boolean"
            },
            "importSlots": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            }
          },
          "required": [
            "provider"
          ]
        },
        "mode": {
          "const": "monitor"
        },
        "tracker": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "database",
        "capture",
        "feed",
        "mode"
      ]
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "capture": {
          "type": "string",
          "minLength": 1
        },
        "feed": {
          "type": "object",
          "properties": {
            "rpcEnv": {
              "type": "string",
              "minLength": 1
            },
            "wsEnv": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "staleMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 300000
            },
            "maxQueue": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8192
            },
            "backlogSlots": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "hydrationDeadlineMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 60000
            },
            "launchesOnly": {
              "type": "boolean"
            },
            "importSlots": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            }
          },
          "required": [
            "provider"
          ]
        },
        "mode": {
          "const": "paper"
        },
        "allowlist": {
          "type": "string",
          "minLength": 1
        },
        "strategy": {
          "type": "object",
          "properties": {
            "startingLamports": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            },
            "spendLamports": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            },
            "maxExposureLamports": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            },
            "dailyLossLamports": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            },
            "networkFeeLamports": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            },
            "priorityFeeLamports": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            },
            "failedFeeLamports": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            },
            "tokenAccountRentLamports": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            },
            "tipLamports": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            },
            "maxOpenPositions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "takeProfitBps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "stopLossBps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "timeExitMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maxLaunchAgeMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "maxStateAgeMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "entryImpactBps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9999
            },
            "exitImpactBps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9999
            },
            "slippageBps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9999
            },
            "maxVenueFeeBps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9999
            },
            "maxAttempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "retryDelayMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "delayMs": {
              "type": "object",
              "properties": {
                "detection": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3600000
                },
                "decision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3600000
                },
                "submission": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3600000
                },
                "landing": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3600000
                }
              },
              "required": [
                "detection",
                "decision",
                "submission",
                "landing"
              ]
            },
            "minCreatorHistorySamples": {
              "type": "integer",
              "minimum": 1
            },
            "minCreatorHistoryCoverageBps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "minCreatorHistoryReturnBps": {
              "type": "integer",
              "minimum": -10000
            },
            "minCreatorInitialBuyLamports": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            },
            "maxConcentrationBps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "exits": {
              "$ref": "./exit-policy.schema.json"
            },
            "riskPolicy": {
              "type": "object",
              "required": [
                "version"
              ],
              "properties": {
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "maxRoundTripLossBps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "minDistinctBuyers": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 256
                },
                "maxHolderConcentrationBps": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                }
              }
            }
          },
          "required": [
            "startingLamports",
            "spendLamports",
            "maxExposureLamports",
            "dailyLossLamports",
            "networkFeeLamports",
            "priorityFeeLamports",
            "failedFeeLamports",
            "maxOpenPositions",
            "timeExitMs",
            "maxLaunchAgeMs",
            "maxStateAgeMs",
            "entryImpactBps",
            "exitImpactBps",
            "slippageBps",
            "maxVenueFeeBps",
            "maxAttempts",
            "retryDelayMs",
            "delayMs"
          ],
          "anyOf": [
            {
              "required": [
                "exits"
              ]
            },
            {
              "required": [
                "takeProfitBps",
                "stopLossBps"
              ]
            }
          ]
        },
        "report": {
          "type": "object",
          "properties": {
            "evaluationStartMs": {
              "type": "integer",
              "minimum": 0
            },
            "evaluationEndMs": {
              "type": "integer",
              "minimum": 0
            },
            "fixedCostsLamports": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            },
            "historicalAllowlistVerified": {
              "type": "boolean"
            },
            "provenance": {
              "type": "string"
            },
            "eurReference": {
              "type": "object",
              "required": [
                "eurCentsPerSol",
                "observedAtMs",
                "source"
              ],
              "properties": {
                "eurCentsPerSol": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,19})$"
                },
                "observedAtMs": {
                  "type": "integer",
                  "minimum": 0
                },
                "source": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tracker": {
          "type": "boolean"
        },
        "shadowModel": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "version",
        "database",
        "capture",
        "feed",
        "mode",
        "allowlist",
        "strategy"
      ]
    }
  ]
}
