{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShahiniBot creator allowlist",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "creators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string",
            "minLength": 1
          },
          "wallet": {
            "type": "string",
            "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
          },
          "method": {
            "enum": [
              "public-account",
              "wallet-challenge"
            ]
          },
          "evidenceRef": {
            "type": "string",
            "minLength": 1
          },
          "verifiedAtMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "activeAtMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "revokedAtMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "delegations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "mint": {
                  "type": "string",
                  "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
                },
                "launchUser": {
                  "type": "string",
                  "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
                },
                "venue": {
                  "const": "6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P"
                },
                "signature": {
                  "type": "string",
                  "minLength": 1
                },
                "issuedAtMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "verifiedAtMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "expiresAtMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "mint",
                "launchUser",
                "venue",
                "signature",
                "issuedAtMs",
                "verifiedAtMs",
                "expiresAtMs"
              ]
            }
          }
        },
        "required": [
          "alias",
          "wallet",
          "method",
          "evidenceRef",
          "verifiedAtMs",
          "activeAtMs"
        ]
      }
    }
  },
  "required": [
    "version",
    "creators"
  ]
}
