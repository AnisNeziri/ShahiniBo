{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShahiniBot exit policy",
  "type": "object",
  "required": [
    "version",
    "takeProfits",
    "stop"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,64}$"
    },
    "takeProfits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "label",
          "unit",
          "value",
          "sellPercent"
        ],
        "properties": {
          "label": {
            "enum": [
              "TP1",
              "TP2",
              "TP3"
            ]
          },
          "unit": {
            "enum": [
              "net_pnl_percent",
              "net_pnl_sol",
              "executable_sol_per_token"
            ]
          },
          "value": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "sellPercent": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          }
        }
      }
    },
    "stop": {
      "type": "object",
      "required": [
        "unit",
        "value"
      ],
      "properties": {
        "unit": {
          "enum": [
            "net_pnl_percent",
            "net_pnl_sol",
            "executable_sol_per_token"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        }
      }
    }
  }
}
